#!/usr/bin/env bash
set -euo pipefail

state_dir="${FAKE_STATE_DIR:?}"
mkdir -p "$state_dir"
printf 'paseo %s\n' "$*" >>"$state_dir/calls.log"

if [[ "${1:-}" == "--host" || "${1:-}" == "--home" ]]; then
  shift 2
fi

if [[ "${1:-}" == "--version" ]]; then
  if [[ -f "$state_dir/installed" ]]; then
    printf '0.9.1\n'
  elif [[ "${FAKE_PASEO_VERSION:-0.9.1}" == "missing" ]]; then
    exit 127
  else
    printf '%s\n' "${FAKE_PASEO_VERSION:-0.9.1}"
  fi
  exit 0
fi

if [[ "${1:-}" == "provider" && "${2:-}" == "diagnostic" ]]; then
  provider="${3:-unknown}"
  family=codex
  [[ "$provider" == opencode* ]] && family=opencode
  if [[ "$family" == codex ]]; then
    diagnostic_state="${FAKE_CODEX_DIAGNOSTIC_STATE:-${FAKE_DIAGNOSTIC_STATE:-ready}}"
    label=Codex
    command_name=codex
  else
    diagnostic_state="${FAKE_OPENCODE_DIAGNOSTIC_STATE:-${FAKE_DIAGNOSTIC_STATE:-ready}}"
    label=OpenCode
    command_name=opencode
  fi
  case "$diagnostic_state" in
    ready)
      diagnostic="$label
  Resolved path: /usr/local/bin/$command_name
  Version: 1.0.0
  Status: Ready"
      ;;
    missing)
      diagnostic="$label
  Resolved path: not found
  Status: Not installed"
      ;;
    auth_required)
      diagnostic="$label
  Resolved path: /usr/local/bin/$command_name
  Version: 1.0.0
  Status: Authentication required"
      ;;
    *)
      diagnostic="$label
  Resolved path: /usr/local/bin/$command_name
  Version: 1.0.0
  Status: Error: incompatible runtime"
      ;;
  esac
  jq -n --arg provider "$provider" --arg diagnostic "$diagnostic" \
    '{provider: $provider, diagnostic: $diagnostic}'
  exit 0
fi

if [[ "${1:-}" == "provider" && "${2:-}" == "models" ]]; then
  case "${3:-}" in
    codex|codex-worker|codex-lead) cat "${FAKE_ROOT:?}/tests/fixtures/models/codex.json" ;;
    opencode|opencode-worker) cat "${FAKE_ROOT:?}/tests/fixtures/models/opencode.json" ;;
    *) exit 2 ;;
  esac
  exit 0
fi

if [[ "${1:-}" == "provider" && "${2:-}" == "ls" ]]; then
  provider_status="${FAKE_PROVIDER_STATUS:-available}"
  printf '{"providers":[{"id":"codex-lead","status":"%s"},{"id":"codex-worker","status":"%s"},{"id":"opencode-worker","status":"%s"}]}\n' \
    "$provider_status" "$provider_status" "$provider_status"
  exit 0
fi

if [[ "${1:-}" == "daemon" && "${2:-}" == "status" ]]; then
  if [[ -f "$state_dir/daemon-running" ]]; then
    printf '{"localDaemon":"running","configuredListen":"127.0.0.1:6767"}\n'
  else
    printf '{"localDaemon":"stopped","configuredListen":"127.0.0.1:6767"}\n'
  fi
  exit 0
fi

if [[ "${1:-}" == "daemon" && "${2:-}" == "config" && "${3:-}" == "set" ]]; then
  [[ "${FAKE_VALIDATE_FAIL:-0}" != 1 ]]
  exit 0
fi

if [[ " $* " == *" reload "* ]]; then
  [[ "${FAKE_RELOAD_FAIL:-0}" != 1 ]]
  printf '{"appliedPaths":["agents.providers","daemon.agentProfiles"]}\n'
  exit 0
fi

if [[ "${1:-}" == "daemon" && "${2:-}" == "start" ]]; then
  touch "$state_dir/daemon-running"
  printf '{"status":"started"}\n'
  exit 0
fi

exit 0
